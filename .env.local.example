# Neon Postgres (Vercel -> Storage -> Neon)
DATABASE_URL=postgres://user:password@host/db?sslmode=require
# Resend.com API key (email notifications)
RESEND_API_KEY=re_xxxxxxxx
# xAI (Grok) key for the "Chat with Mike" widget
XAI_API_KEY=xai-xxxxxxxx

# --- Google Ads conversion labels (optional) -------------------------------
# Create each conversion in Google Ads -> Goals -> Conversions, open "Tag setup",
# and copy the label: the part AFTER the slash in send_to.
# Example: send_to 'AW-18321801016/AbC-D_efGhIjKlMn' -> label is AbC-D_efGhIjKlMn
# Add these in Vercel -> Settings -> Environment Variables, then redeploy.
# Leaving one unset is safe: the GA4 event still fires, only the Ads-side
# conversion is skipped for that action.
NEXT_PUBLIC_ADS_LABEL_PHONE_CALL=
NEXT_PUBLIC_ADS_LABEL_SMS_CLICK=
NEXT_PUBLIC_ADS_LABEL_CALLBACK=
NEXT_PUBLIC_ADS_LABEL_CHAT_LEAD=
NEXT_PUBLIC_ADS_LABEL_TALKNOW=
NEXT_PUBLIC_ADS_LABEL_QUOTE=
